<Project>
  <PropertyGroup>
    <AutoFixtureVersion>4.18.1</AutoFixtureVersion>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <ReactiveUIVersion>20.1.63</ReactiveUIVersion>
    <SystemIOAbstractionsVersion>22.3.0</SystemIOAbstractionsVersion>
    <WixVersion>5.0.2</WixVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AutoFixture" Version="$(AutoFixtureVersion)" />
    <PackageVersion Include="AutoFixture.AutoMoq" Version="$(AutoFixtureVersion)" />
    <PackageVersion Include="AutoFixture.Xunit2" Version="$(AutoFixtureVersion)" />
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
    <PackageVersion Include="DynamicData" Version="9.5.0" />
    <!-- Do not switch to non-free version 8 or greater of FluentAssertions -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Fody" Version="6.9.3" />
    <PackageVersion Include="Microsoft.DotNet.ILCompiler" Version="10.0.14" />
    <PackageVersion Include="libczicompressc" Version="0.5.7" />
    <PackageVersion Include="MessageBox.Avalonia" Version="3.3.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Projektanker.Icons.Avalonia.FontAwesome" Version="9.6.2" />
    <PackageVersion Include="ReactiveUI" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.Fody" Version="19.5.41" />
    <PackageVersion Include="Splat" Version="15.5.3" />
    <PackageVersion Include="StyleCop.Analyzers.Unstable" Version="1.2.0.556" />
    <PackageVersion Include="System.IO.Abstractions" Version="$(SystemIOAbstractionsVersion)" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="$(SystemIOAbstractionsVersion)" />
    <PackageVersion Include="System.Reactive" Version="6.1.0" />
    <PackageVersion Include="WixToolset.Util.wixext" Version="$(WixVersion)" />
    <PackageVersion Include="WixToolset.Heat" Version="$(WixVersion)" />
    <PackageVersion Include="WixToolset.Bal.wixext" Version="$(WixVersion)" />
    <PackageVersion Include="WixToolset.UI.wixext" Version="$(WixVersion)" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>