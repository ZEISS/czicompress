<UserControl
    x:Class="netczicompress.Views.AdvancedOptionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:netczicompress.ViewModels.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:netczicompress.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:netczicompress.ViewModels"
    d:DesignHeight="100"
    d:DesignWidth="430"
    x:DataType="vm:IAdvancedOptionsViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ThreadCountToDecimalConverter x:Key="ThreadCountToDecimalConverter" />
            <converters:CompressionLevelToDecimalConverter x:Key="CompressionLevelToDecimalConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid ColumnDefinitions="Auto,20,60*" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
        <Label
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center">
            Copy files that fail processing
        </Label>
        <CheckBox
            Grid.Row="0"
            Grid.Column="2"
            VerticalAlignment="Center"
            IsChecked="{Binding CopyFailedFiles}"
            ToolTip.Tip="If a selected scientific file fails processing or verification, try copying the original unchanged to the destination." />
        <Label
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center">
            Threads
        </Label>
        <!--  ReflectionBinding used to avoid null problems  -->
        <NumericUpDown
            Grid.Row="2"
            Grid.Column="2"
            VerticalAlignment="Center"
            ClipValueToMinMax="True"
            Increment="1"
            Maximum="{Binding ThreadCount.Maximum, Mode=OneWay}"
            Minimum="{Binding ThreadCount.Minimum, Mode=OneWay}"
            ParsingNumberStyle="Integer"
            ToolTip.Tip="Number of concurrent tasks. HDF5 and TIFF files are processed one at a time to limit memory use."
            Value="{Binding ThreadCount, Converter={StaticResource ThreadCountToDecimalConverter}}" />
        <Label
            Grid.Row="3"
            Grid.Column="0"
            VerticalAlignment="Center">
            Compression Level
        </Label>
        <!--  ReflectionBinding used to avoid null problems  -->
        <NumericUpDown
            Grid.Row="3"
            Grid.Column="2"
            VerticalAlignment="Center"
            ClipValueToMinMax="True"
            Increment="1"
            Maximum="{Binding CompressionLevel.Maximum, Mode=OneWay}"
            Minimum="{Binding CompressionLevel.Minimum, Mode=OneWay}"
            ParsingNumberStyle="Integer"
            ToolTip.Tip="CZI uses Zstandard levels 0–22. HDF5 and TIFF use lossless Deflate levels 1–9; values outside that range are clamped. Higher levels take more time."
            Value="{Binding CompressionLevel, Converter={StaticResource CompressionLevelToDecimalConverter}}" />
        <Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">Process HDF5 (.h5, .hdf5)</Label>
        <CheckBox Grid.Row="4" Grid.Column="2" IsChecked="{Binding ProcessHdf5}"
                  ToolTip.Tip="Repack with the official HDF5 tools using lossless gzip and shuffle. Verifies datasets and attributes with h5diff. External and virtual datasets are reported as unsupported." />
        <Label Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">Process TIFF / OME-TIFF</Label>
        <CheckBox Grid.Row="5" Grid.Column="2" IsChecked="{Binding ProcessTiff}"
                  ToolTip.Tip="Lossless Deflate compression, with page, pixel and metadata verification. Unsupported proprietary metadata layouts are reported as errors." />
        <Label
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center">
            Copy other files and folders
        </Label>
        <CheckBox
            Grid.Row="1"
            Grid.Column="2"
            VerticalAlignment="Center"
            IsChecked="{Binding CopyOtherFiles}"
            ToolTip.Tip="Copy files not selected for processing unchanged, preserving the folder structure and empty folders. Follows the subfolders setting. Existing destination files are skipped. Dry Run only lists files." />
    </Grid>
</UserControl>
